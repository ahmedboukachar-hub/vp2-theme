{{ 'section-password-editorial.css' | asset_url | stylesheet_tag }}
{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}

<section class="password-editorial color-{{ section.settings.color_scheme }} gradient">
  <div class="password-editorial__inner">
    <div class="password-editorial__copy">
      <p class="vp-eyebrow">{{ 'general.password_page.eyebrow' | t }}</p>
      <h1 class="password-editorial__heading">{{ 'general.password_page.hero_heading' | t }}</h1>
      <p class="password-editorial__body">{{ 'general.password_page.hero_body' | t }}</p>

      {%- if section.settings.show_signup -%}
        {% form 'customer', class: 'password-editorial__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="password-editorial__field field">
            <input
              id="PasswordNewsletter--{{ section.id }}"
              type="email"
              name="contact[email]"
              class="field__input"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              {% if form.errors %}aria-invalid="true" aria-describedby="PasswordNewsletterError--{{ section.id }}"{% endif %}
              placeholder="{{ 'newsletter.label' | t }}"
              required
            >
            <label class="field__label" for="PasswordNewsletter--{{ section.id }}">{{ 'newsletter.label' | t }}</label>
            <button type="submit" class="button" name="commit">{{ 'newsletter.button_label' | t }}</button>
          </div>

          {%- if form.errors -%}
            <small class="password-editorial__message" id="PasswordNewsletterError--{{ section.id }}">
              {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
            </small>
          {%- endif -%}
          {%- if form.posted_successfully? -%}
            <p class="password-editorial__message" role="status">{{ 'newsletter.success' | t }}</p>
          {%- else -%}
            <p class="password-editorial__note">{{ 'general.password_page.newsletter_note' | t }}</p>
          {%- endif -%}
        {% endform %}
      {%- endif -%}
    </div>

    <div class="password-editorial__media color-{{ section.settings.media_color_scheme }} gradient">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1800
          | image_tag:
            class: 'password-editorial__image',
            loading: 'eager',
            fetchpriority: 'high',
            widths: '600, 900, 1200, 1500, 1800',
            sizes: '(min-width: 750px) 54vw, 100vw',
            alt: section.settings.image.alt | default: shop.name | escape
        }}
      {%- else -%}
        <div class="password-editorial__placeholder" aria-hidden="true">
          <span class="password-editorial__orb password-editorial__orb--one"></span>
          <span class="password-editorial__orb password-editorial__orb--two"></span>
          <svg viewBox="0 0 320 320" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M89 132h142l16 119H73l16-119Z" stroke="currentColor" stroke-width="2"/>
            <path d="M119 132c0-34 16-58 41-58s41 24 41 58" stroke="currentColor" stroke-width="2"/>
            <path d="M73 201h174" stroke="currentColor" stroke-width="1" opacity=".35"/>
          </svg>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial password page",
  "enabled_on": { "templates": ["password"] },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Editorial image",
      "info": "Use an owned image without visible faces or third-party campaign assets."
    },
    {
      "type": "checkbox",
      "id": "show_signup",
      "label": "Show email signup",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Text panel color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "media_color_scheme",
      "label": "Media panel color scheme",
      "default": "scheme-2"
    }
  ],
  "presets": [{ "name": "Editorial password page" }]
}
{% endschema %}
