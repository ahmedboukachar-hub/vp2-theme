{{ 'component-journal-card.css' | asset_url | stylesheet_tag }}
{{ 'section-article-related.css' | asset_url | stylesheet_tag }}

{%- liquid
  # Pick up to three other articles: those sharing the most tags with this one
  # first (same house and type), then the newest. No tag names are hardcoded.
  assign picked = ','
  assign related_count = 0
  for threshold in (1..3)
    assign min_shared = 4 | minus: threshold
    for other in blog.articles
      if related_count == 3
        break
      endif
      if other.id == article.id
        continue
      endif
      assign other_key = ',' | append: other.id | append: ','
      if picked contains other_key
        continue
      endif
      assign shared = 0
      for tag in other.tags
        if article.tags contains tag
          assign shared = shared | plus: 1
        endif
      endfor
      if shared >= min_shared
        assign picked = picked | append: other.id | append: ','
        assign related_count = related_count | plus: 1
      endif
    endfor
  endfor
  for other in blog.articles
    if related_count == 3
      break
    endif
    if other.id == article.id
      continue
    endif
    assign other_key = ',' | append: other.id | append: ','
    unless picked contains other_key
      assign picked = picked | append: other.id | append: ','
      assign related_count = related_count | plus: 1
    endunless
  endfor
  assign picked_ids = picked | split: ','
-%}

<div class="article-related color-{{ section.settings.color_scheme }} gradient vp-section">
  <div class="vp-width">
    {%- if related_count > 0 -%}
      <h2 class="vp-heading-section article-related__heading">
        {{- section.settings.heading | escape -}}
      </h2>
      <ul class="article-related__grid" role="list">
        {%- for picked_id in picked_ids -%}
          {%- for other in blog.articles -%}
            {%- assign other_id = other.id | append: '' -%}
            {%- if other_id == picked_id -%}
              <li>
                {% render 'journal-card',
                  article: other,
                  variant: 'grid',
                  show_excerpt: false,
                  sizes: '(min-width: 990px) 30vw, (min-width: 750px) 30vw, 100vw'
                %}
              </li>
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.cta_heading != blank -%}
      <div class="article-related__cta{% if related_count == 0 %} article-related__cta--solo{% endif %}">
        <h2 class="vp-heading-section">{{ section.settings.cta_heading | escape }}</h2>
        {%- if section.settings.cta_text != blank -%}
          <div class="vp-lead rte">{{ section.settings.cta_text }}</div>
        {%- endif -%}
        {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
          <div class="vp-actions">
            <a href="{{ section.settings.cta_link }}" class="button">{{ section.settings.cta_label | escape }}</a>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Related reading",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Continue reading" },
    { "type": "text", "id": "cta_heading", "label": "CTA heading", "default": "Looking for a particular model?" },
    {
      "type": "richtext",
      "id": "cta_text",
      "label": "CTA text",
      "default": "<p>Share the designer, model or era you have in mind and use our Find a Bag request to guide our sourcing.</p>"
    },
    { "type": "text", "id": "cta_label", "label": "CTA button label", "default": "Start a search request" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-3" }
  ],
  "presets": [{ "name": "Related reading" }]
}
{% endschema %}
