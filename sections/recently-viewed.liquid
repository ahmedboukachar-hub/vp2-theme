{{ 'component-recently-viewed.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
<script src="{{ 'recently-viewed.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<recently-viewed
  class="recently-viewed section-{{ section.id }}-padding no-js-hidden"
  data-current-handle="{{ product.handle }}"
  data-root-url="{{ routes.root_url }}"
  data-section-id="{{ section.id }}"
  hidden
>
  <div class="page-width">
    <h2 class="recently-viewed__heading h2">{{ 'products.product.recently_viewed' | t }}</h2>
  </div>
  {%- comment -%}
    Same grid, cards and slider as "You may also like". recently-viewed.js fills the
    list and turns it into a swipeable row below 990px when there are more cards
    than fit next to each other; otherwise it drops the slider buttons.
  {%- endcomment -%}
  <slider-component class="slider-mobile-gutter page-width-desktop page-width">
    <ul
      id="Slider-{{ section.id }}"
      class="grid product-grid grid--3-col-desktop grid--2-col-tablet-down"
      role="list"
      aria-label="{{ 'general.slider.name' | t }}"
      data-recently-viewed-grid
    ></ul>
    {% render 'slider-buttons', slider_id: section.id %}
  </slider-component>
</recently-viewed>

{% schema %}
{
  "name": "Recently viewed",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows up to three recently viewed products from this browser. Hidden on a first visit and without JavaScript. No tracking; data stays in the visitor's browser."
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
