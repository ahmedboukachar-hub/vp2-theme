{{ 'section-main-page.css' | asset_url | stylesheet_tag }}
{{ 'component-faq.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="page-width page-width--narrow section-{{ section.id }}-padding">
  {%- if section.index == 1 -%}
  <h1 class="main-page-title page-title h0{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    {{ page.title | escape }}
  </h1>
  {%- endif -%}
  <div class="rte faq-content{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    {{ page.content }}
  </div>
</div>

{%- comment -%}
  FAQPage structured data built from the page's own details/summary blocks, so
  search engines and AI assistants can quote each answer with its question.
{%- endcomment -%}
{%- liquid
  assign faq_blocks = page.content | split: '<details'
  assign faq_count = faq_blocks.size | minus: 1
-%}
{%- if faq_count > 0 -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "name": {{ page.title | json }},
    "url": {{ canonical_url | json }},
    "inLanguage": {{ request.locale.iso_code | json }},
    {%- capture faq_items -%}
      {%- for block in faq_blocks offset: 1 -%}
        {%- liquid
          assign question = block | split: '<summary' | last | split: '</summary>' | first | split: '>' | slice: 1, 50 | join: '>' | strip_html | strip_newlines | strip | replace: '&amp;', '&' | replace: '&nbsp;', ' '
          assign answer = block | split: '</summary>' | last | split: '</details>' | first | replace: '</p>', ' </p>' | replace: '</li>', ' </li>' | replace: '<br', ' <br' | strip_html | strip_newlines | strip | replace: '&amp;', '&' | replace: '&nbsp;', ' '
        -%}
        {%- if question != blank and answer != blank -%}
        { "@type": "Question", "name": {{ question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ answer | json }} } },
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    "mainEntity": [ {{ faq_items | strip | remove_last: ',' }} ]
  }
</script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Renders the page content. Use headings for FAQ groups and details/summary blocks for questions, so answers expand accessibly without JavaScript."
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
