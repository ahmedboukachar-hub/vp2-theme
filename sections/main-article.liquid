{{ 'section-main-article.css' | asset_url | stylesheet_tag }}

{%- assign topic = article.tags | first -%}

<article class="article-page color-{{ section.settings.color_scheme }} gradient" itemscope itemtype="https://schema.org/BlogPosting">
  <div class="vp-width article-page__intro{% if article.image and section.settings.show_image %} article-page__intro--with-media{% endif %}">
    <header class="article-page__header">
      {%- assign article_brand = settings.brand_display_name | default: shop.name -%}
      <meta itemprop="datePublished" content="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%:z' }}">
      <meta itemprop="dateModified" content="{{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%:z' }}">
      <link itemprop="mainEntityOfPage" href="{{ canonical_url }}">
      <meta itemprop="inLanguage" content="{{ request.locale.iso_code }}">
      {%- if article.image -%}
        <link itemprop="image" href="https:{{ article.image | image_url: width: 1600 }}">
      {%- endif -%}
      <span itemprop="author" itemscope itemtype="https://schema.org/Organization" hidden>
        <meta itemprop="name" content="{{ article_brand | escape }}">
        <link itemprop="url" href="{{ shop.url }}">
      </span>
      <span itemprop="publisher" itemscope itemtype="https://schema.org/Organization" hidden>
        <meta itemprop="name" content="{{ article_brand | escape }}">
        <link itemprop="url" href="{{ shop.url }}">
        {%- if settings.logo != blank -%}
          <span itemprop="logo" itemscope itemtype="https://schema.org/ImageObject">
            <link itemprop="url" href="https:{{ settings.logo | image_url: width: 600 }}">
          </span>
        {%- endif -%}
      </span>
      {%- if topic != blank and section.settings.show_topic -%}
        <a class="vp-eyebrow article-page__topic" href="{{ blog.url }}/tagged/{{ topic | handleize }}">
          {% render 'journal-topic', topic: topic %}
        </a>
      {%- endif -%}

      <h1 class="vp-heading-display article-page__title" itemprop="headline">{{ article.title | escape }}</h1>

      {%- if article.excerpt != blank -%}
        <div class="article-page__standfirst rte">{{ article.excerpt }}</div>
      {%- endif -%}
    </header>
    {%- if article.image and section.settings.show_image -%}
      <div class="article-page__lead-media vp-media vp-media--3x2">
        {{
          article.image
          | image_url: width: 1800
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '375, 550, 750, 1100, 1400, 1800',
            sizes: '(min-width: 750px) 42vw, 100vw',
            itemprop: 'image',
            alt: article.image.alt | escape
        }}
      </div>
    {%- endif -%}
  </div>

  <div class="vp-width">
    <div class="article-page__body vp-rte rte" itemprop="articleBody">
      {{ article.content | replace: '<table', '<div class="vp-table-scroll" tabindex="0"><table' | replace: '</table>', '</table></div>' }}
    </div>

    {%- if section.settings.show_share -%}
      {%- assign share_url = request.origin | append: article.url -%}
      <div class="article-page__share">
        {% render 'share-button', block: section, share_link: share_url %}
      </div>
    {%- endif -%}
  </div>
</article>

{% schema %}
{
  "name": "t:sections.main-article.name",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "show_topic", "label": "Show the article topic", "default": true },
    { "type": "checkbox", "id": "show_image", "label": "Show the lead image", "default": true },
    { "type": "checkbox", "id": "show_share", "label": "Show the share button", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
