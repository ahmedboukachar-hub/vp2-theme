{{ 'section-main-article.css' | asset_url | stylesheet_tag }}

{%- assign topic = article.tags | first -%}

<article class="article-page color-{{ section.settings.color_scheme }} gradient" itemscope itemtype="http://schema.org/BlogPosting">
  <div class="vp-width">
    <header class="article-page__header">
      <meta itemprop="datePublished" content="{{ article.published_at | date: '%Y-%m-%d' }}">
      {%- if topic != blank and section.settings.show_topic -%}
        <a class="vp-eyebrow article-page__topic" href="{{ blog.url }}/tagged/{{ topic | handleize }}">
          {% render 'journal-topic', topic: topic %}
        </a>
      {%- endif -%}

      <h1 class="vp-heading-display article-page__title" itemprop="headline">{{ article.title | escape }}</h1>

      {%- if article.excerpt != blank -%}
        <div class="article-page__standfirst rte">{{ article.excerpt }}</div>
      {%- endif -%}

    </header>
  </div>

  {%- if article.image and section.settings.show_image -%}
    <div class="article-page__lead">
      <div class="vp-width">
        <div class="article-page__lead-media vp-media vp-media--3x2">
          {{
            article.image
            | image_url: width: 2400
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '550, 750, 1100, 1500, 1800, 2200, 2400',
              sizes: '(min-width: 1440px) 1400px, 100vw',
              itemprop: 'image',
              alt: article.image.alt | escape
          }}
        </div>
      </div>
    </div>
  {%- endif -%}

  <div class="vp-width">
    <div class="article-page__body vp-rte rte" itemprop="articleBody">
      {{ article.content }}
    </div>

    {%- if section.settings.show_share -%}
      {%- assign share_url = request.origin | append: article.url -%}
      <div class="article-page__share">
        {% render 'share-button', block: section, share_link: share_url %}
      </div>
    {%- endif -%}
  </div>
</article>

{% schema %}
{
  "name": "t:sections.main-article.name",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "show_topic", "label": "Show the article topic", "default": true },
    { "type": "checkbox", "id": "show_image", "label": "Show the lead image", "default": true },
    { "type": "checkbox", "id": "show_share", "label": "Show the share button", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
