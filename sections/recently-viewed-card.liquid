{%- comment -%}
  One product card for the product in context, shared by Recently viewed
  (assets/recently-viewed.js) and the wishlist page (assets/wishlist.js). Both fetch it
  through the Section Rendering API (/products/<handle>?section_id=recently-viewed-card),
  so they show exactly the same cards as "You may also like". Not meant to be added in
  the Theme Editor (no presets).
{%- endcomment -%}
{%- if product -%}
  {% render 'card-product',
    columns: 4,
    card_product: product,
    media_aspect_ratio: 'portrait',
    image_shape: 'default',
    show_secondary_image: true,
    show_vendor: false,
    show_rating: false,
    product_view_context: 'recommendation'
  %}
{%- endif -%}

{% schema %}
{
  "name": "Recently viewed card",
  "settings": []
}
{% endschema %}
