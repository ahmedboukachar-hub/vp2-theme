{{ 'section-service-panel.css' | asset_url | stylesheet_tag }}

<div class="service-panel color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="service-panel__inner{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="service-panel__eyebrow caption-with-letter-spacing">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="service-panel__heading inline-richtext {{ section.settings.heading_size }}">
          {{- section.settings.heading -}}
        </h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="service-panel__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
      <div class="service-panel__actions">
        {%- if section.settings.button_label != blank -%}
          <a
            {% if section.settings.button_link == blank %}
              role="link"
              aria-disabled="true"
            {% else %}
              href="{{ section.settings.button_link }}"
            {% endif %}
            class="button"
          >
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
        {%- if section.settings.link_label != blank and section.settings.link_url != blank -%}
          <a href="{{ section.settings.link_url }}" class="link underlined-link">
            {{- section.settings.link_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Service panel",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Personal sourcing"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Looking for a particular piece?"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Tell us the house, model, colour or era you have in mind. We will keep your request in view as we source new pieces.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Start a search"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Text link label"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Text link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    }
  ],
  "presets": [
    {
      "name": "Service panel"
    }
  ]
}
{% endschema %}
