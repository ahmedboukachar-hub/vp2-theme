{{ 'section-archive-feature.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign archive_collection = collections[section.settings.collection]
  assign limit = section.settings.products_to_show | at_most: 3
-%}

{%- if archive_collection != blank and archive_collection.products.size > 0 -%}
  <div class="archive-feature vp-section color-{{ section.settings.color_scheme }} gradient">
    <div class="vp-width">
      <div class="archive-feature__header">
        <div class="vp-section__header">
          {%- if section.settings.eyebrow != blank -%}
            <span class="vp-eyebrow">{{ section.settings.eyebrow | escape }}</span>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="vp-heading-section inline-richtext">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <div class="vp-lead rte">{{ section.settings.text }}</div>
          {%- endif -%}
        </div>
        {%- if section.settings.button_label != blank -%}
          <a href="{{ archive_collection.url }}" class="vp-link vp-link--arrow archive-feature__cta">
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
      </div>

      <ul class="archive-feature__grid" role="list">
        {%- for product in archive_collection.products limit: limit -%}
          {%- liquid
            assign designer = product.metafields.custom.designer.value | default: product.vendor
            assign model = product.metafields.custom.model.value | default: product.title
          -%}
          <li class="archive-feature__item">
            <a class="archive-feature__link" href="{{ product.url }}">
              <div class="archive-feature__media vp-media vp-media--4x5 vp-media--zoom">
                {%- if product.featured_media -%}
                  {{
                    product.featured_media
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '200, 300, 450, 600, 900',
                      sizes: '(min-width: 990px) 30vw, 45vw',
                      alt: product.featured_media.alt | escape
                  }}
                {%- else -%}
                  <span class="archive-feature__placeholder">
                    {{- 'products.product.media.photography_pending' | t -}}
                  </span>
                {%- endif -%}
                <span class="archive-feature__flag">{{ 'sections.archive.previously_sourced' | t }}</span>
              </div>
              <div class="archive-feature__info">
                {%- if designer != blank -%}
                  <span class="archive-feature__designer">{{ designer | escape }}</span>
                {%- endif -%}
                <span class="archive-feature__model">{{ model | escape }}</span>
                {%- if section.settings.show_price -%}
                  <span class="archive-feature__price">{{ product.price | money }}</span>
                {%- endif -%}
                <span class="archive-feature__state">{{ 'sections.archive.found_new_home' | t }}</span>
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Archive teaser",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows previously sourced pieces as an editorial record. Never renders an add-to-cart control; at most three pieces on desktop and two on mobile."
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Previously sourced" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "From the archive" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "collection", "id": "collection", "label": "Archive collection" },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Pieces to show on desktop",
      "info": "Mobile always shows two.",
      "min": 2,
      "max": 3,
      "step": 1,
      "default": 3
    },
    { "type": "checkbox", "id": "show_price", "label": "Show the price these pieces sold at", "default": false },
    { "type": "text", "id": "button_label", "label": "Link label", "default": "Explore the archive" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Archive teaser" }]
}
{% endschema %}
