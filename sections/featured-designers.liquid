{{ 'section-featured-designers.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign visible_blocks = 0
  for block in section.blocks
    if block.settings.collection != blank
      assign visible_blocks = visible_blocks | plus: 1
    endif
  endfor
-%}

{%- if visible_blocks > 0 -%}
  <div class="featured-designers vp-section color-{{ section.settings.color_scheme }} gradient">
    <div class="vp-width">
      <div class="vp-section__header">
        {%- if section.settings.eyebrow != blank -%}
          <span class="vp-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="vp-heading-section inline-richtext">{{ section.settings.title }}</h2>
        {%- endif -%}
      </div>

      <ul class="featured-designers__list featured-designers__list--{{ section.settings.columns_desktop }}" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign designer_collection = block.settings.collection
            if designer_collection == blank
              continue
            endif
            assign designer_name = block.settings.title | default: designer_collection.title
          -%}
          <li class="featured-designers__item" {{ block.shopify_attributes }}>
            <a class="featured-designers__link" href="{{ designer_collection.url }}">
              <div class="featured-designers__media vp-media vp-media--4x5 vp-media--zoom">
                {%- if designer_collection.featured_image != blank -%}
                  {{
                    designer_collection.featured_image
                    | image_url: width: 1600
                    | image_tag:
                      loading: 'lazy',
                      widths: '400, 600, 800, 1100, 1400, 1600',
                      sizes: '(min-width: 990px) 46vw, 100vw',
                      alt: designer_collection.featured_image.alt | default: designer_name
                  }}
                {%- endif -%}
              </div>
              <div class="featured-designers__info">
                <h3 class="featured-designers__name">{{ designer_name | escape }}</h3>
                <span class="vp-link vp-link--arrow featured-designers__cta">
                  {{- 'sections.featured_designers.explore' | t: designer: designer_name -}}
                </span>
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Featured designers",
  "tag": "section",
  "max_blocks": 4,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The houses" },
    { "type": "inline_richtext", "id": "title", "label": "Heading", "default": "Houses that shaped the modern handbag." },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Cards per row on desktop",
      "options": [
        { "value": "2", "label": "2 — large editorial cards" },
        { "value": "3", "label": "3" }
      ],
      "default": "2"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    {
      "type": "paragraph",
      "content": "Only designers with a linked, existing collection are shown. Use your own collection imagery (recommended ratio 4:5) — no brand logos."
    }
  ],
  "blocks": [
    {
      "type": "designer",
      "name": "Designer",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Name override" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured designers",
      "blocks": [{ "type": "designer" }, { "type": "designer" }]
    }
  ]
}
{% endschema %}
