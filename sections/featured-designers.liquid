{{ 'section-featured-designers.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="featured-designers color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding center">
    {%- if section.settings.title != blank -%}
      <h2 class="featured-designers__heading inline-richtext {{ section.settings.heading_size }}">
        {{- section.settings.title -}}
      </h2>
    {%- endif -%}
    <ul class="featured-designers__list" role="list">
      {%- for block in section.blocks -%}
        {%- if block.settings.title != blank -%}
          <li class="featured-designers__item" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a class="featured-designers__link link" href="{{ block.settings.link }}">
                {{- block.settings.title | escape -}}
              </a>
            {%- else -%}
              <span>{{ block.settings.title | escape }}</span>
            {%- endif -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Featured designers",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "default": "Selected houses"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h2"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "designer",
      "name": "Designer",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Name"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "For example a collection filtered on this designer."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured designers",
      "blocks": [
        { "type": "designer" },
        { "type": "designer" },
        { "type": "designer" }
      ]
    }
  ]
}
{% endschema %}
