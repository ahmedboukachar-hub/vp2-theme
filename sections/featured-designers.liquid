{%- comment -%} Homepage and Designers page: one card per designer collection. {%- endcomment -%}
{{ 'section-featured-designers.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign visible_blocks = 0
  for block in section.blocks
    if block.settings.collection != blank
      assign visible_blocks = visible_blocks | plus: 1
    endif
  endfor
-%}

{%- if visible_blocks > 0 -%}
  <div class="featured-designers vp-section color-{{ section.settings.color_scheme }} gradient">
    <div class="vp-width">
      <div class="vp-section__header">
        {%- if section.settings.eyebrow != blank -%}
          <span class="vp-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="vp-heading-section inline-richtext">{{ section.settings.title }}</h2>
        {%- else -%}
          <h2 class="visually-hidden">{{ 'accessibility.heading_houses' | t }}</h2>
        {%- endif -%}
      </div>

      <ul class="featured-designers__list featured-designers__list--{{ section.settings.columns_desktop }}" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign designer_collection = block.settings.collection
            if designer_collection == blank
              continue
            endif
            assign designer_name = block.settings.title | default: designer_collection.title
          -%}
          {%- liquid
            # Rendered image widths, matching the grid in section-featured-designers.css
            # (1440px canvas, 5rem gutters and 6.4rem gaps from 750px; 1.5rem gutters
            # and a 4rem gap below). On the two-up grid a small card is a horizontal
            # card from 990px, its photo half the card width.
            assign card_size = block.settings.size | default: 'large'
            if section.settings.columns_desktop == '3'
              assign card_sizes = '(min-width: 1440px) 404px, (min-width: 750px) calc(33.3vw - 76px), calc(100vw - 30px)'
              if card_size == 'small'
                assign card_sizes = '(min-width: 1440px) 170px, (min-width: 750px) calc(16.7vw - 70px), calc(50vw - 35px)'
              endif
            else
              assign card_sizes = '(min-width: 1440px) 638px, (min-width: 750px) calc(50vw - 82px), calc(100vw - 30px)'
              if card_size == 'small'
                assign card_sizes = '(min-width: 1440px) 307px, (min-width: 990px) calc(25vw - 53px), (min-width: 750px) calc(50vw - 82px), calc(50vw - 35px)'
              endif
            endif
            assign focus = block.settings.image_position | default: 'center'
          -%}
          <li class="featured-designers__item featured-designers__item--{{ card_size }}" {{ block.shopify_attributes }}>
            <a class="featured-designers__link" href="{{ designer_collection.url }}" aria-labelledby="FeaturedDesigner-{{ block.id }}">
              <div class="featured-designers__media vp-media vp-media--4x5 vp-media--zoom" style="--vp-media-position: center {{ focus }};">
                {%- if designer_collection.featured_image != blank -%}
                  {{
                    designer_collection.featured_image
                    | image_url: width: 1600
                    | image_tag:
                      loading: 'lazy',
                      widths: '400, 600, 800, 1100, 1400, 1600',
                      sizes: card_sizes,
                      alt: ''
                  }}
                {%- endif -%}
              </div>
              <div class="featured-designers__info">
                <h3 class="featured-designers__name" id="FeaturedDesigner-{{ block.id }}">{{ designer_name | escape }}</h3>
                <span class="vp-link vp-link--arrow featured-designers__cta" aria-hidden="true">
                  {{- 'sections.featured_designers.explore' | t: designer: designer_name -}}
                </span>
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Featured designers",
  "tag": "section",
  "max_blocks": 4,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The houses" },
    { "type": "inline_richtext", "id": "title", "label": "Heading", "default": "Houses that shaped the modern handbag." },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Cards per row on desktop",
      "options": [
        { "value": "2", "label": "2 large cards per row (small cards: 2 shorter cards per row)" },
        { "value": "3", "label": "3 large cards per row (small cards: 6 per row)" }
      ],
      "default": "2"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    {
      "type": "paragraph",
      "content": "Only designers with a linked, existing collection are shown. Use your own collection imagery (cropped to 4:5) — no brand logos. Mark secondary houses as small cards: on phones two sit side by side, on larger screens they fill the row as shorter cards."
    }
  ],
  "blocks": [
    {
      "type": "designer",
      "name": "Designer",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Name override" },
        {
          "type": "select",
          "id": "size",
          "label": "Card size",
          "options": [
            { "value": "large", "label": "Large" },
            { "value": "small", "label": "Small (shorter card, two side by side)" }
          ],
          "default": "large"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image focus",
          "info": "Which part of the image to keep when it is cropped to 4:5.",
          "options": [
            { "value": "top", "label": "Top" },
            { "value": "center", "label": "Centre" },
            { "value": "bottom", "label": "Bottom" }
          ],
          "default": "center"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured designers",
      "blocks": [{ "type": "designer" }, { "type": "designer" }]
    }
  ]
}
{% endschema %}
