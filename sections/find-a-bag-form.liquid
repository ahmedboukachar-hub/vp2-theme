{{ 'section-main-page.css' | asset_url | stylesheet_tag }}
{{ 'component-inspection.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .find-a-bag__form .field,
  .find-a-bag__field {
    margin-bottom: 1.5rem;
  }

  .find-a-bag__field label {
    display: block;
    margin-bottom: 0.6rem;
  }

  .find-a-bag__consent {
    margin: 1.5rem 0;
    font-size: 1.3rem;
    opacity: 0.85;
  }

  .find-a-bag__closing {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 0.1rem solid rgba(var(--color-foreground), 0.08);
    font-style: italic;
  }
  .find-a-bag__preferences { margin:2.4rem 0; border-block:1px solid rgba(var(--color-foreground),.15); }
  .find-a-bag__preferences summary { padding:1.6rem 0; min-height:5.2rem; cursor:pointer; }

  .find-a-bag__budget {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .find-a-bag__budget .field {
    flex: 1 1 auto;
    margin-bottom: 0;
  }

  .find-a-bag__currency {
    flex: 0 0 12rem;
    width: 12rem;
  }

  .find-a-bag__form .select__select {
    font-size: 1.6rem;
    color: rgb(var(--color-foreground));
  }

  .find-a-bag__form .select .svg-wrapper {
    right: 1.6rem;
  }
{%- endstyle -%}

<div class="page-width page-width--narrow section-{{ section.id }}-padding">
  {%- if section.index == 1 -%}<h1 class="main-page-title page-title h0">{{ page.title | escape }}</h1>{%- endif -%}
  <div class="rte">{{ page.content }}</div>

  {%- form 'contact', id: 'FindABagForm', class: 'find-a-bag__form' -%}
    {%- if form.posted_successfully? -%}
      <div class="form__message" tabindex="-1" autofocus role="status">
        <h2 class="h4">{{ 'templates.find_a_bag.success_heading' | t }}</h2>
        <p>{{ 'templates.find_a_bag.success_body' | t }}</p>
      </div>
    {%- else -%}
      {%- if form.errors -%}
        <p class="form__message" tabindex="-1" autofocus role="alert">
          {{ 'icon-error.svg' | inline_asset_content }}
          {{ 'templates.contact.form.error_heading' | t }}
        </p>
      {%- endif -%}

      <input type="hidden" name="contact[{{ 'templates.find_a_bag.hidden_source' | t }}]" value="Find a Bag">

      {%- liquid
        assign label_designer = 'templates.find_a_bag.fields.designer' | t
        assign label_model = 'templates.find_a_bag.fields.model_or_style' | t
        assign label_budget = 'templates.find_a_bag.fields.maximum_budget' | t
        assign label_currency = 'templates.find_a_bag.fields.currency' | t
        assign label_condition = 'templates.find_a_bag.fields.minimum_condition' | t
        assign selected_currency = cart.currency.iso_code | default: 'EUR'
      -%}

      <div class="field">
        <input type="text" id="FindABag-name" name="contact[{{ 'templates.find_a_bag.fields.name' | t }}]" class="field__input" autocomplete="name" placeholder="{{ 'templates.find_a_bag.fields.name' | t }}">
        <label for="FindABag-name" class="field__label">{{ 'templates.find_a_bag.fields.name' | t }}</label>
      </div>
      <div class="field">
        <input
          type="email"
          id="FindABag-email"
          name="contact[email]"
          class="field__input"
          value="{{ form.email }}"
          autocomplete="email"
          placeholder="{{ 'templates.find_a_bag.fields.email' | t }}"
          required
          aria-required="true"
          {% if form.errors contains 'email' %}
            aria-invalid="true"
            aria-describedby="FindABag-email-error"
          {% endif %}
        >
        <label for="FindABag-email" class="field__label">
          {{- 'templates.find_a_bag.fields.email' | t }}
          <span aria-hidden="true">*</span></label
        >
        {%- if form.errors contains 'email' -%}
          <small id="FindABag-email-error" class="contact__field-error">
            {{ form.errors.translated_fields.email | capitalize }}
            {{ form.errors.messages.email }}
          </small>
        {%- endif -%}
      </div>
      <div class="field">
        <input
          type="text"
          id="FindABag-designer"
          name="contact[{{ label_designer }}]"
          class="field__input"
          list="FindABag-designers"
          autocomplete="off"
          placeholder="{{ label_designer }}"
        >
        <label for="FindABag-designer" class="field__label">{{ label_designer }}</label>
        {%- comment -%} Suggestions only: any house can still be typed. {%- endcomment -%}
        <datalist id="FindABag-designers">
          {%- for vendor in shop.vendors -%}
            {%- assign vendor_key = vendor | handleize -%}
            {%- if vendor_key == 'unbranded' -%}{%- continue -%}{%- endif -%}
            <option value="{{ vendor | escape }}"></option>
          {%- endfor -%}
        </datalist>
      </div>
      <div class="field">
        <input type="text" id="FindABag-model_or_style" name="contact[{{ label_model }}]" class="field__input" placeholder="{{ label_model }}">
        <label for="FindABag-model_or_style" class="field__label">{{ label_model }}</label>
      </div>
      <div class="find-a-bag__budget">
        <div class="field">
          <input
            type="text"
            inputmode="numeric"
            id="FindABag-maximum_budget"
            name="contact[{{ label_budget }}]"
            class="field__input"
            autocomplete="off"
            placeholder="{{ label_budget }}"
          >
          <label for="FindABag-maximum_budget" class="field__label">{{ label_budget }}</label>
        </div>
        <div class="select find-a-bag__currency">
          <label for="FindABag-currency" class="visually-hidden">{{ label_currency }}</label>
          <select id="FindABag-currency" name="contact[{{ label_currency }}]" class="select__select">
            <option value="EUR"{% if selected_currency == 'EUR' %} selected{% endif %}>EUR €</option>
            <option value="GBP"{% if selected_currency == 'GBP' %} selected{% endif %}>GBP £</option>
            <option value="CHF"{% if selected_currency == 'CHF' %} selected{% endif %}>CHF</option>
            <option value="USD"{% if selected_currency == 'USD' %} selected{% endif %}>USD $</option>
          </select>
          <span class="svg-wrapper">
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </span>
        </div>
      </div>
      <details class="find-a-bag__preferences">
        <summary>{{ 'templates.find_a_bag.optional_details' | t }}</summary>
        {%- assign extra_fields = 'country,preferred_size,preferred_colour,preferred_material,preferred_era,minimum_condition,flexible_details,reference_link' | split: ',' -%}
        {%- for field_key in extra_fields -%}
          {%- if field_key == 'minimum_condition' -%}
            {%- comment -%} The four condition grades of the catalogue (docs/taxonomy.md). {%- endcomment -%}
            <div class="find-a-bag__field">
              <label for="FindABag-minimum_condition" class="form__label">{{ label_condition }}</label>
              <div class="select">
                <select id="FindABag-minimum_condition" name="contact[{{ label_condition }}]" class="select__select">
                  <option value="{{ 'templates.find_a_bag.no_preference' | t }}">{{ 'templates.find_a_bag.no_preference' | t }}</option>
                  <option value="{{ 'products.values.excellent' | t }}">{{ 'products.values.excellent' | t }}</option>
                  <option value="{{ 'products.values.very_good' | t }}">{{ 'products.values.very_good' | t }}</option>
                  <option value="{{ 'products.values.good' | t }}">{{ 'products.values.good' | t }}</option>
                  <option value="{{ 'products.values.fair' | t }}">{{ 'products.values.fair' | t }}</option>
                </select>
                <span class="svg-wrapper">
                  {{- 'icon-caret.svg' | inline_asset_content -}}
                </span>
              </div>
            </div>
            {%- continue -%}
          {%- endif -%}
          {%- assign field_label_key = 'templates.find_a_bag.fields.' | append: field_key -%}
          {%- assign field_label = field_label_key | t -%}
          <div class="field">
            <input type="text" id="FindABag-{{ field_key }}" name="contact[{{ field_label }}]" class="field__input"{% if field_key == 'country' %} autocomplete="country-name"{% endif %} placeholder="{{ field_label }}">
            <label for="FindABag-{{ field_key }}" class="field__label">{{ field_label }}</label>
          </div>
        {%- endfor -%}
      </details>
      <div class="field">
        <textarea rows="5" id="FindABag-notes" name="contact[body]" class="text-area field__input" placeholder="{{ 'templates.find_a_bag.fields.notes' | t }}">{{ form.body }}</textarea>
        <label for="FindABag-notes" class="form__label field__label">{{ 'templates.find_a_bag.fields.notes' | t }}</label>
      </div>

      {%- assign consent_text = 'templates.find_a_bag.consent' | t -%}
      {% render 'form-privacy-note', text: consent_text, class: 'find-a-bag__consent' %}
      <button type="submit" class="button">{{ 'templates.find_a_bag.submit' | t }}</button>
    {%- endif -%}
  {%- endform -%}

  <p class="find-a-bag__closing">{{ 'templates.find_a_bag.closing' | t }}</p>
</div>

{% schema %}
{
  "name": "Find a Bag form",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Personal sourcing request form. Editorial copy comes from the page content; labels come from locale files and are fully translated."
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ]
}
{% endschema %}
