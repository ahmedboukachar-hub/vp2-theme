{{ 'component-journal-card.css' | asset_url | stylesheet_tag }}
{{ 'section-journal-feature.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign journal = blogs[section.settings.blog]
  assign lead_article = section.settings.lead_article | default: journal.articles.first
  assign second_article = section.settings.second_article
  assign third_article = section.settings.third_article
-%}

{%- if journal != blank and journal.articles_count > 0 -%}
  <div class="journal-feature vp-section color-{{ section.settings.color_scheme }} gradient">
    <div class="vp-width">
      <div class="journal-feature__header">
        <div class="vp-section__header">
          {%- if section.settings.eyebrow != blank -%}
            <span class="vp-eyebrow">{{ section.settings.eyebrow | escape }}</span>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="vp-heading-section inline-richtext">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <div class="vp-lead rte">{{ section.settings.text }}</div>
          {%- endif -%}
        </div>
        {%- if section.settings.button_label != blank -%}
          <a href="{{ journal.url }}" class="button button--secondary journal-feature__cta">
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
      </div>

      <div class="journal-feature__grid">
        <div class="journal-feature__lead">
          {% render 'journal-card',
            article: lead_article,
            variant: 'lead',
            index: 1,
            sizes: '(min-width: 990px) 55vw, 100vw'
          %}
        </div>
        <div class="journal-feature__secondary">
          {%- if second_article != blank and second_article.id != lead_article.id -%}
            {% render 'journal-card', article: second_article, variant: 'secondary', show_excerpt: false, sizes: '150px' %}
          {%- endif -%}
          {%- if third_article != blank and third_article.id != lead_article.id and third_article.id != second_article.id -%}
            {% render 'journal-card', article: third_article, variant: 'secondary', show_excerpt: false, sizes: '150px' %}
          {%- endif -%}
          {%- if second_article == blank and third_article == blank -%}
            {%- assign fallback_count = 0 -%}
            {%- for item in journal.articles -%}
              {%- if item.id == lead_article.id -%}{%- continue -%}{%- endif -%}
              {% render 'journal-card', article: item, variant: 'secondary', show_excerpt: false, sizes: '150px' %}
              {%- assign fallback_count = fallback_count | plus: 1 -%}
              {%- if fallback_count == 2 -%}{%- break -%}{%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Journal feature",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "article", "id": "lead_article", "label": "Featured article" },
    { "type": "article", "id": "second_article", "label": "Second article" },
    { "type": "article", "id": "third_article", "label": "Third article" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Journal" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "The stories behind the bags." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Introduction",
      "default": "<p>Buying guides, model histories and practical advice on condition and care—written for collectors and first-time buyers.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Link label", "default": "Read the Journal" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" }
  ],
  "presets": [{ "name": "Journal feature" }]
}
{% endschema %}
