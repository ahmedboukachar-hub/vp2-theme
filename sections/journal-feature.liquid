{{ 'component-journal-card.css' | asset_url | stylesheet_tag }}
{{ 'section-journal-feature.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign journal = blogs[section.settings.blog]
-%}

{%- if journal != blank and journal.articles_count > 0 -%}
  <div class="journal-feature vp-section color-{{ section.settings.color_scheme }} gradient">
    <div class="vp-width">
      <div class="journal-feature__header">
        <div class="vp-section__header">
          {%- if section.settings.eyebrow != blank -%}
            <span class="vp-eyebrow">{{ section.settings.eyebrow | escape }}</span>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="vp-heading-section inline-richtext">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <div class="vp-lead rte">{{ section.settings.text }}</div>
          {%- endif -%}
        </div>
        {%- if section.settings.button_label != blank -%}
          <a href="{{ journal.url }}" class="vp-link vp-link--arrow journal-feature__cta">
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
      </div>

      <div class="journal-feature__grid">
        {%- for article in journal.articles limit: 3 -%}
          {%- if forloop.first -%}
            <div class="journal-feature__lead">
              {% render 'journal-card',
                article: article,
                variant: 'lead',
                sizes: '(min-width: 990px) 60vw, 100vw'
              %}
            </div>
          {%- else -%}
            {%- if forloop.index == 2 -%}<div class="journal-feature__secondary">{%- endif -%}
            {% render 'journal-card',
              article: article,
              variant: 'secondary',
              show_excerpt: false,
              sizes: '(min-width: 990px) 18vw, 40vw'
            %}
            {%- if forloop.last -%}</div>{%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Journal feature",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Journal" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Stories behind the pieces." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Introduction",
      "default": "<p>Guides to iconic models, materials, condition and care—created to help you choose with confidence and appreciate what makes each piece endure.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Link label", "default": "Explore the Journal" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-3" }
  ],
  "presets": [{ "name": "Journal feature" }]
}
{% endschema %}
