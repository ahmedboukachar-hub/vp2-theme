{{ 'section-main-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  # The page text is the primary content: no reveal when this section opens
  # the page or directly follows the page hero, where it is (partly) above
  # the fold on load.
  assign reveal = false
  if settings.animations_reveal_on_scroll and section.index > 2
    assign reveal = true
  endif
-%}

<div class="vp-width section-{{ section.id }}-padding main-page {% if section.settings.principles_layout %}main-page--principles{% else %}main-page--measure{% endif %}">
  {%- if section.settings.show_title -%}
    <h1 class="main-page-title page-title vp-heading-display">
      {{ page.title | escape }}
    </h1>
  {%- endif -%}
  <div class="vp-rte rte{% if reveal %} scroll-trigger animate--slide-in{% endif %}">
    {{ page.content | replace: '<table', '<div class="vp-table-scroll" tabindex="0"><table' | replace: '</table>', '</table></div>' }}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show the page title",
      "info": "Turn this off when a Page hero section above already provides the H1.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "principles_layout",
      "label": "Two-column principles layout",
      "info": "Places each H2 beside its paragraph on desktop. Used by the Our Curation page.",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
