{{ 'section-authenticity-process.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="authenticity-process color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width page-width--narrow section-{{ section.id }}-padding">
    {%- if section.settings.caption != blank -%}
      <p class="authenticity-process__caption caption-with-letter-spacing">{{ section.settings.caption | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="authenticity-process__heading inline-richtext {{ section.settings.heading_size }}">
        {{- section.settings.heading -}}
      </h2>
    {%- endif -%}
    {%- if section.settings.intro != blank -%}
      <div class="authenticity-process__intro rte">{{ section.settings.intro }}</div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ol class="authenticity-process__steps">
        {%- for block in section.blocks -%}
          {%- if block.settings.heading != blank or block.settings.text != blank -%}
            <li class="authenticity-process__step" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h3 class="authenticity-process__step-heading h5">{{ block.settings.heading | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="authenticity-process__step-text rte">{{ block.settings.text }}</div>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
    {%- endif -%}

    {%- if section.settings.documentation_heading != blank or section.settings.documentation_text != blank -%}
      <div class="authenticity-process__extra">
        {%- if section.settings.documentation_heading != blank -%}
          <h3 class="authenticity-process__extra-heading h5">{{ section.settings.documentation_heading | escape }}</h3>
        {%- endif -%}
        {%- if section.settings.documentation_text != blank -%}
          <div class="rte">{{ section.settings.documentation_text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.guarantee_heading != blank or section.settings.guarantee_text != blank -%}
      <div class="authenticity-process__extra">
        {%- if section.settings.guarantee_heading != blank -%}
          <h3 class="authenticity-process__extra-heading h5">{{ section.settings.guarantee_heading | escape }}</h3>
        {%- endif -%}
        {%- if section.settings.guarantee_text != blank -%}
          <div class="rte">{{ section.settings.guarantee_text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Authenticity process",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Keep this section hidden until the authentication process is final. Only publish steps, documentation and guarantees that are actually in place — no unverified claims."
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "default": "Authenticity"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "A considered approach to authenticity"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction"
    },
    {
      "type": "header",
      "content": "Documentation"
    },
    {
      "type": "text",
      "id": "documentation_heading",
      "label": "Documentation heading"
    },
    {
      "type": "richtext",
      "id": "documentation_text",
      "label": "Documentation text",
      "info": "For example which papers, receipts or codes are included, once that is settled."
    },
    {
      "type": "header",
      "content": "Guarantee"
    },
    {
      "type": "text",
      "id": "guarantee_heading",
      "label": "Guarantee heading"
    },
    {
      "type": "richtext",
      "id": "guarantee_text",
      "label": "Guarantee text",
      "info": "Only fill in once a real authenticity guarantee exists."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Inspection step",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Authenticity process",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ]
}
{% endschema %}
