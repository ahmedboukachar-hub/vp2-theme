{{ 'section-editorial-split-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading_tag = 'h2'
  if template.name == 'index' and section.index == 1
    assign heading_tag = 'h1'
  endif
  # The first section is in view on load, so its copy shows at once; a split hero further down keeps the reveal.
  assign reveal_copy = false
  if settings.animations_reveal_on_scroll and section.index > 1
    assign reveal_copy = true
  endif
  if section.settings.use_brand_copy
    assign hero_eyebrow = 'brand.hero.eyebrow' | t
    assign hero_heading = 'brand.hero.heading' | t | escape
    assign hero_intro = 'brand.hero.intro' | t
    assign primary_label = 'brand.hero.primary' | t
    assign secondary_label = 'brand.hero.secondary' | t
  else
    assign hero_eyebrow = section.settings.eyebrow
    assign hero_heading = section.settings.heading
    assign primary_label = section.settings.button_label
    assign secondary_label = section.settings.link_label
  endif
-%}

<div
  id="SplitHero-{{ section.id }}"
  class="split-hero color-{{ section.settings.color_scheme }} gradient{% if section.settings.image == blank %} split-hero--no-image{% endif %}"
>
  <div class="split-hero__copy">
    <div class="split-hero__copy-inner{% if reveal_copy %} scroll-trigger animate--slide-in{% endif %}">
      {%- if hero_eyebrow != blank -%}
        <span class="vp-eyebrow">{{ hero_eyebrow | escape }}</span>
      {%- endif -%}
      {%- if hero_heading != blank -%}
        {%- liquid
          # A plain-text heading of several sentences breaks between its sentences first, in every language.
          assign split_sentences = false
          unless hero_heading contains '<'
            assign hero_sentences = hero_heading | split: '. '
            if hero_sentences.size > 1
              assign split_sentences = true
            endif
          endunless
        -%}
        <{{ heading_tag }} class="vp-heading-hero inline-richtext">
          {%- if split_sentences -%}
            {%- for sentence in hero_sentences -%}
              <span class="split-hero__sentence">{{ sentence }}{% unless forloop.last %}.{% endunless %}</span>
              {%- unless forloop.last %} {% endunless -%}
            {%- endfor -%}
          {%- else -%}
            {{- hero_heading -}}
          {%- endif -%}
        </{{ heading_tag }}>
      {%- endif -%}
      {%- if section.settings.use_brand_copy -%}
        <div class="vp-lead rte"><p>{{ hero_intro | escape }}</p></div>
      {%- elsif section.settings.text != blank -%}
        <div class="vp-lead rte">{{ section.settings.text }}</div>
      {%- endif -%}
      <div class="vp-actions split-hero__actions">
        {%- if primary_label != blank -%}
          <a
            {% if section.settings.button_link == blank %}
              role="link" aria-disabled="true"
            {% else %}
              href="{{ section.settings.button_link }}"
            {% endif %}
            class="button split-hero__button"
          >
            {{- primary_label | escape -}}
          </a>
        {%- endif -%}
        {%- if secondary_label != blank and section.settings.link_url != blank -%}
          <a href="{{ section.settings.link_url }}" class="button button--secondary split-hero__button">
            {{- secondary_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="split-hero__media vp-media" {% if section.settings.image == blank %}aria-hidden="true"{% endif %}>
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '375, 550, 750, 800, 1000, 1100, 1300, 1500, 1800, 2400',
          sizes: '(min-width: 750px) 54vw, 100vw'
      }}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Editorial split hero",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "One strong editorial image of a real piece, cropped edge to edge. Leave empty for a deliberate typographic hero on a neutral field."
    },
    {
      "type": "checkbox",
      "id": "use_brand_copy",
      "label": "Use translated brand copy for this hero",
      "info": "The texts then come from the translated brand copy and the text fields are hidden; the links below stay editable.",
      "default": false
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Curated vintage & pre-owned", "visible_if": "{{ section.settings.use_brand_copy == false }}" },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Iconic bags, chosen one by one.",
      "visible_if": "{{ section.settings.use_brand_copy == false }}"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>A considered collection of vintage and pre-owned designer bags, selected for their character, condition and enduring appeal.</p>",
      "visible_if": "{{ section.settings.use_brand_copy == false }}"
    },
    { "type": "text", "id": "button_label", "label": "Primary button label", "default": "Shop new arrivals", "visible_if": "{{ section.settings.use_brand_copy == false }}" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "link_label", "label": "Secondary link label", "default": "Explore designers", "visible_if": "{{ section.settings.use_brand_copy == false }}" },
    { "type": "url", "id": "link_url", "label": "Secondary link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Editorial split hero" }]
}
{% endschema %}
