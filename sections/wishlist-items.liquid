{{ 'component-wishlist.css' | asset_url | stylesheet_tag }}
<script src="{{ 'wishlist.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="page-width page-width--narrow section-{{ section.id }}-padding">
  {%- liquid
    assign heading_tag = 'h1'
    if section.index > 1
      assign heading_tag = 'h2'
    endif
  -%}
  {%- if section.settings.show_title -%}
  <{{ heading_tag }} class="main-page-title page-title h0">{{ page.title | escape }}</{{ heading_tag }}>
  {%- endif -%}
  <p class="wishlist-items__intro">{{ 'general.wishlist.intro' | t }}</p>

  <noscript>
    <p>{{ 'general.wishlist.requires_js' | t }}</p>
  </noscript>

  <wishlist-items
    class="wishlist-items no-js-hidden"
    data-root-url="{{ routes.root_url }}"
    data-money-format="{% if settings.currency_code_enabled %}{{ shop.money_with_currency_format | escape }}{% else %}{{ shop.money_format | escape }}{% endif %}"
    data-remove-label="{{ 'general.wishlist.remove' | t | escape }}"
    data-removed-notice="{{ 'general.wishlist.removed_notice' | t: title: '[title]' | escape }}"
  >
    <p class="visually-hidden" role="status" data-wishlist-status></p>
    <div class="wishlist-items__empty" data-wishlist-empty hidden>
      <h2 class="h3" tabindex="-1" data-wishlist-empty-heading>{{ 'general.wishlist.empty_heading' | t }}</h2>
      <p>{{ 'general.wishlist.empty_body' | t }}</p>
      <a href="{{ collections['all-bags'].url | default: routes.all_products_collection_url }}" class="button">{{ 'general.wishlist.empty_cta' | t }}</a>
    </div>
    <ul class="wishlist-items__grid list-unstyled" role="list" data-wishlist-grid hidden></ul>
    <template>
      <li class="wishlist-card" data-wishlist-card>
        <a data-wishlist-link href="#" class="wishlist-card__link">
          <span class="wishlist-card__media"><img data-wishlist-image alt="" loading="lazy" width="600" height="750"></span>
          <span data-wishlist-title class="wishlist-card__title"></span>
        </a>
        <span class="wishlist-card__unavailable" data-wishlist-unavailable hidden>{{ 'general.wishlist.unavailable' | t }}</span>
        <p data-wishlist-price class="wishlist-card__price">&nbsp;</p>
        <button type="button" class="wishlist-card__remove link underlined-link" data-wishlist-remove>
          {{- 'general.wishlist.remove_short' | t -}}
        </button>
      </li>
    </template>
    {%- comment -%}
      Shows the empty state or one placeholder card per saved piece before
      first paint, so nothing below moves when wishlist.js fills them in.
      Keep in step with buildCard() in assets/wishlist.js.
    {%- endcomment -%}
    <script>
      (function () {
        try {
          var root = document.currentScript.parentNode;
          var items = JSON.parse(window.localStorage.getItem('wishlist-items') || '[]');
          if (!Array.isArray(items)) items = [];
          var grid = root.querySelector('[data-wishlist-grid]');
          if (grid.children.length) return;
          var card = root.querySelector('template').content.querySelector('[data-wishlist-card]');
          root.querySelector('[data-wishlist-empty]').hidden = items.length > 0;
          grid.hidden = items.length === 0;
          items.slice(0, 50).forEach(function (item) {
            var placeholder = card.cloneNode(true);
            placeholder.dataset.handle = item.handle;
            placeholder.querySelector('[data-wishlist-title]').textContent = item.title || item.handle;
            if (item.url) placeholder.querySelector('[data-wishlist-link]').setAttribute('href', item.url);
            grid.appendChild(placeholder);
          });
        } catch (error) {
          /* wishlist.js renders the list once it runs */
        }
      })();
    </script>
  </wishlist-items>
</div>

{% schema %}
{
  "name": "Wishlist",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show page title",
      "info": "Turn off when a page hero above already shows the title.",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "Renders the browser-local wishlist. Items are stored only in the visitor's browser and do not sync between devices."
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ]
}
{% endschema %}
