{{ 'component-wishlist.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
<script src="{{ 'wishlist.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="page-width section-{{ section.id }}-padding">
  {%- liquid
    assign heading_tag = 'h1'
    if section.index > 1
      assign heading_tag = 'h2'
    endif
  -%}
  {%- if section.settings.show_title -%}
  <{{ heading_tag }} class="main-page-title page-title h0">{{ page.title | escape }}</{{ heading_tag }}>
  {%- endif -%}
  <p class="wishlist-items__intro">{{ 'general.wishlist.intro' | t }}</p>

  <noscript>
    <p>{{ 'general.wishlist.requires_js' | t }}</p>
  </noscript>

  <wishlist-items
    class="wishlist-items no-js-hidden"
    data-root-url="{{ routes.root_url }}"
    data-remove-label="{{ 'general.wishlist.remove' | t | escape }}"
    data-removed-notice="{{ 'general.wishlist.removed_notice' | t: title: '[title]' | escape }}"
  >
    <p class="visually-hidden" role="status" data-wishlist-status></p>
    <div class="wishlist-items__empty" data-wishlist-empty hidden>
      <h2 class="h3" tabindex="-1" data-wishlist-empty-heading>{{ 'general.wishlist.empty_heading' | t }}</h2>
      <p>{{ 'general.wishlist.empty_body' | t }}</p>
      <a href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}" class="button">{{ 'general.wishlist.empty_cta' | t }}</a>
    </div>
    {%- comment -%}
      Same grid and cards as "You may also like" and Recently viewed: wishlist.js
      fetches each card through the Section Rendering API
      (/products/<handle>?section_id=recently-viewed-card) and swaps it in for
      the placeholder below, which has the card's shape (square image box,
      title, detail line, price) so nothing moves when the card arrives.
    {%- endcomment -%}
    <ul
      class="wishlist-items__grid grid product-grid grid--4-col-desktop grid--2-col-tablet-down"
      role="list"
      data-wishlist-grid
      hidden
    ></ul>
    <template>
      <li class="grid__item wishlist-card" data-wishlist-card>
        <div class="card-wrapper product-card-wrapper underline-links-hover" data-wishlist-placeholder>
          <div class="card card--{{ settings.card_style }} card--media{% if settings.card_style == 'card' %} color-{{ settings.card_color_scheme }} gradient{% endif %}">
            <div class="card__inner{% if settings.card_style == 'standard' %} color-{{ settings.card_color_scheme }} gradient{% endif %} ratio">
              <div class="card__media"></div>
            </div>
            <div class="card__content">
              <div class="card__information">
                <h3 class="card__heading h5">
                  <a class="full-unstyled-link" data-wishlist-link></a>
                </h3>
                <div class="card-information">
                  <div class="card__meta-line" data-wishlist-pending>&nbsp;</div>
                  <div class="price" data-wishlist-pending>&nbsp;</div>
                  <span class="wishlist-card__unavailable" data-wishlist-unavailable hidden>
                    {{- 'general.wishlist.unavailable' | t -}}
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
        <button type="button" class="wishlist-card__remove link underlined-link" data-wishlist-remove>
          {{- 'general.wishlist.remove_short' | t -}}
        </button>
      </li>
    </template>
    {%- comment -%}
      Shows the empty state or one placeholder card per saved piece before
      first paint, so nothing below moves when wishlist.js fills them in.
      Keep in step with buildCard() in assets/wishlist.js.
    {%- endcomment -%}
    <script>
      (function () {
        try {
          var root = document.currentScript.parentNode;
          var items = JSON.parse(window.localStorage.getItem('wishlist-items') || '[]');
          if (!Array.isArray(items)) items = [];
          var grid = root.querySelector('[data-wishlist-grid]');
          if (grid.children.length) return;
          var card = root.querySelector('template').content.querySelector('[data-wishlist-card]');
          root.querySelector('[data-wishlist-empty]').hidden = items.length > 0;
          grid.hidden = items.length === 0;
          items.slice(0, 50).forEach(function (item) {
            var placeholder = card.cloneNode(true);
            var link = placeholder.querySelector('[data-wishlist-link]');
            placeholder.dataset.handle = item.handle;
            placeholder.dataset.title = item.title || item.handle;
            link.textContent = placeholder.dataset.title;
            if (item.url) link.setAttribute('href', item.url);
            grid.appendChild(placeholder);
          });
        } catch (error) {
          /* wishlist.js renders the list once it runs */
        }
      })();
    </script>
  </wishlist-items>
</div>

{% schema %}
{
  "name": "Wishlist",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show page title",
      "info": "Turn off when a page hero above already shows the title.",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "Renders the browser-local wishlist. Items are stored only in the visitor's browser and do not sync between devices."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection for 'Explore all bags'",
      "info": "Button shown when the wishlist is empty. Empty: all products."
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ]
}
{% endschema %}
