{{ 'section-main-page.css' | asset_url | stylesheet_tag }}
{{ 'component-inspection.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .sell-to-us__form .field {
    margin-bottom: 1.5rem;
  }

  .sell-to-us__hint {
    margin: -0.8rem 0 1.5rem;
    font-size: 1.2rem;
    opacity: 0.75;
  }

  .sell-to-us__disclaimer {
    margin: 1.5rem 0;
    font-size: 1.3rem;
    opacity: 0.85;
  }
{%- endstyle -%}

<div class="page-width page-width--narrow section-{{ section.id }}-padding">
  <h1 class="main-page-title page-title h0">{{ page.title | escape }}</h1>
  <div class="rte">{{ page.content }}</div>

  {%- form 'contact', id: 'SellToUsForm', class: 'sell-to-us__form' -%}
    {%- if form.posted_successfully? -%}
      <p class="form__message" tabindex="-1" autofocus role="status">
        {{ 'icon-success.svg' | inline_asset_content }}
        {{ 'templates.sell_to_us.success' | t }}
      </p>
    {%- else -%}
      {%- if form.errors -%}
        <p class="form__message" tabindex="-1" autofocus role="alert">
          {{ 'icon-error.svg' | inline_asset_content }}
          {{ 'templates.contact.form.error_heading' | t }}
        </p>
      {%- endif -%}

      <input type="hidden" name="contact[{{ 'templates.sell_to_us.hidden_source' | t }}]" value="Sell to Us">

      <div class="field">
        <input type="text" id="SellToUs-name" name="contact[{{ 'templates.sell_to_us.fields.name' | t }}]" class="field__input" autocomplete="name" placeholder="{{ 'templates.sell_to_us.fields.name' | t }}">
        <label for="SellToUs-name" class="field__label">{{ 'templates.sell_to_us.fields.name' | t }}</label>
      </div>
      <div class="field">
        <input
          type="email"
          id="SellToUs-email"
          name="contact[email]"
          class="field__input"
          value="{{ form.email }}"
          autocomplete="email"
          placeholder="{{ 'templates.sell_to_us.fields.email' | t }}"
          required
          aria-required="true"
          {% if form.errors contains 'email' %}
            aria-invalid="true"
            aria-describedby="SellToUs-email-error"
          {% endif %}
        >
        <label for="SellToUs-email" class="field__label">{{ 'templates.sell_to_us.fields.email' | t }}</label>
        {%- if form.errors contains 'email' -%}
          <small id="SellToUs-email-error" class="contact__field-error">
            {{ form.errors.translated_fields.email | capitalize }}
            {{ form.errors.messages.email }}
          </small>
        {%- endif -%}
      </div>
      {%- liquid
        assign text_fields = 'country,item_type,brand_and_model,approximate_year,condition_description,included_accessories,proof_of_purchase,asking_price,preferred_contact' | split: ','
      -%}
      {%- for field_key in text_fields -%}
        {%- assign field_label_key = 'templates.sell_to_us.fields.' | append: field_key -%}
        {%- assign field_label = field_label_key | t -%}
        <div class="field">
          <input type="text" id="SellToUs-{{ field_key }}" name="contact[{{ field_label }}]" class="field__input" placeholder="{{ field_label }}">
          <label for="SellToUs-{{ field_key }}" class="field__label">{{ field_label }}</label>
        </div>
      {%- endfor -%}
      <div class="field">
        <input type="text" id="SellToUs-serial" name="contact[{{ 'templates.sell_to_us.serial' | t }}]" class="field__input" placeholder="{{ 'templates.sell_to_us.serial' | t }}">
        <label for="SellToUs-serial" class="field__label">{{ 'templates.sell_to_us.serial' | t }}</label>
      </div>
      <p class="sell-to-us__hint">{{ 'templates.sell_to_us.serial_hint' | t }}</p>
      <div class="field">
        <textarea rows="5" id="SellToUs-message" name="contact[body]" class="text-area field__input" placeholder="{{ 'templates.sell_to_us.fields.message' | t }}">{{ form.body }}</textarea>
        <label for="SellToUs-message" class="form__label field__label">{{ 'templates.sell_to_us.fields.message' | t }}</label>
      </div>

      <p class="sell-to-us__disclaimer">{{ 'templates.sell_to_us.disclaimer' | t }}</p>
      <button type="submit" class="button">{{ 'templates.sell_to_us.submit' | t }}</button>
    {%- endif -%}
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Sell to Us form",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Item submission form for the Sell to Us page. Editorial copy comes from the page content; labels come from locale files. The page stays unpublished until the buying service is confirmed."
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ]
}
{% endschema %}
