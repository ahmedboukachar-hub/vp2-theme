{% comment %}
  Wishlist heart button (browser-local wishlist, no account, no tracking —
  see docs/wishlist-and-recently-viewed.md).

  Its stylesheet and script are loaded once in layout/theme.liquid.

  Accepts:
  - wishlist_product: {Object} Product or card product Liquid object
{% endcomment %}

<wishlist-button
  class="wishlist-button no-js-hidden"
  data-product-handle="{{ wishlist_product.handle }}"
  data-product-id="{{ wishlist_product.id }}"
  data-product-title="{{ wishlist_product.title | escape }}"
  data-product-url="{{ wishlist_product.url }}"
>
  <button
    type="button"
    class="wishlist-button__toggle"
    aria-pressed="false"
    data-label-add="{{ 'general.wishlist.add' | t | escape }}: {{ wishlist_product.title | escape }}"
    data-label-remove="{{ 'general.wishlist.remove' | t | escape }}: {{ wishlist_product.title | escape }}"
    aria-label="{{ 'general.wishlist.add' | t | escape }}: {{ wishlist_product.title | escape }}"
  >
    <span class="svg-wrapper">{{ 'icon-heart.svg' | inline_asset_content }}</span>
  </button>
</wishlist-button>
