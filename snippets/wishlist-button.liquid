{% comment %}
  Wishlist heart button (browser-local wishlist, no account, no tracking —
  see docs/wishlist-and-recently-viewed.md).

  Its stylesheet and script are loaded once in layout/theme.liquid.

  Accepts:
  - wishlist_product: {Object} Product or card product Liquid object
  - show_label: {Boolean} Show a visible "Save" / "Saved" text next to the
    heart (product page). The accessible name then starts with that text.
    Default: false (icon only, as on product cards) (optional)
{% endcomment %}

{%- liquid
  assign wishlist_title = wishlist_product.title | escape
  if show_label
    assign wishlist_label_add = 'general.wishlist.save' | t | escape | append: ': ' | append: wishlist_title
    assign wishlist_label_remove = 'general.wishlist.saved' | t | escape | append: ': ' | append: wishlist_title
  else
    assign wishlist_label_add = 'general.wishlist.add' | t | escape | append: ': ' | append: wishlist_title
    assign wishlist_label_remove = 'general.wishlist.remove' | t | escape | append: ': ' | append: wishlist_title
  endif
-%}

<wishlist-button
  class="wishlist-button no-js-hidden{% if show_label %} wishlist-button--labelled{% endif %}"
  data-product-handle="{{ wishlist_product.handle }}"
  data-product-id="{{ wishlist_product.id }}"
  data-product-title="{{ wishlist_title }}"
  data-product-url="{{ wishlist_product.url }}"
>
  <button
    type="button"
    class="wishlist-button__toggle"
    aria-pressed="false"
    data-label-add="{{ wishlist_label_add }}"
    data-label-remove="{{ wishlist_label_remove }}"
    aria-label="{{ wishlist_label_add }}"
  >
    <span class="svg-wrapper">{{ 'icon-heart.svg' | inline_asset_content }}</span>
    {%- if show_label -%}
      <span class="wishlist-button__label wishlist-button__label--add" aria-hidden="true">
        {{- 'general.wishlist.save' | t -}}
      </span>
      <span class="wishlist-button__label wishlist-button__label--saved" aria-hidden="true">
        {{- 'general.wishlist.saved' | t -}}
      </span>
    {%- endif -%}
  </button>
</wishlist-button>
