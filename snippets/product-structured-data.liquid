{% doc %}
  Product structured data (schema.org/Product) for pre-owned pieces.
  Replaces Dawn's generic `structured_data` output so search engines get the
  item condition (used, for pieces tagged `bag`), every product photo, the
  brand and one offer per variant, with shipping and return facts from the
  theme settings (Search engine details) for the countries of the store's
  markets.

  @param {object} product - The product to describe.
{% enddoc %}
{%- liquid
  assign product_url = request.origin | append: product.url
  assign image_count = 0
  assign is_used = false
  if product.tags contains 'bag'
    assign is_used = true
  endif
  assign country_codes = ''
  for country in localization.available_countries
    assign country_codes = country_codes | append: country.iso_code | append: ','
  endfor
  assign country_codes = country_codes | split: ','
  assign mf = product.metafields.custom
  assign condition_grade = mf.condition | metafield_text
  assign year_or_era = mf.year_or_era | metafield_text
  assign dimensions = mf.dimensions | metafield_text
  assign inclusions = mf.inclusions.value | join: ', '
  assign model_name = mf.model | metafield_text
  assign material = mf.material | metafield_text
  assign color = mf.color | metafield_text
  assign size_category = mf.size_category | metafield_text
  assign condition_summary = mf.condition_summary | metafield_text | newline_to_br | replace: '<br />', ' · ' | strip_html | strip_newlines | strip
  assign product_sku = product.selected_or_first_available_variant.sku | default: product.variants.first.sku
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "@id": {{ product_url | append: '#product' | json }},
    "name": {{ product.title | json }},
    "url": {{ product_url | json }},
    {%- if product.description != blank %}
    "description": {{ product.description | replace: '</p>', ' </p>' | replace: '</li>', ' </li>' | replace: '</h2>', ' </h2>' | replace: '</h3>', ' </h3>' | replace: '<br', ' <br' | strip_html | strip_newlines | strip | truncate: 5000 | json }},
    {%- endif %}
    "image": [
      {%- for media in product.media -%}
        {%- if media.media_type == 'image' and image_count < 10 -%}
          {%- if image_count > 0 -%},{%- endif -%}
          {{ media | image_url: width: 1600 | prepend: 'https:' | json }}
          {%- assign image_count = image_count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    ],
    "inLanguage": {{ request.locale.iso_code | json }},
    {%- if product_sku != blank %}
    "sku": {{ product_sku | json }},
    {%- endif %}
    {%- if product.type != blank %}
    "category": {{ product.type | json }},
    {%- endif %}
    {%- if product.vendor != blank %}
    "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
    {%- endif %}
    {%- if model_name != blank %}
    "model": {{ model_name | json }},
    {%- endif %}
    {%- if material != blank %}
    "material": {{ material | json }},
    {%- endif %}
    {%- if color != blank %}
    "color": {{ color | json }},
    {%- endif %}
    {%- comment -%} Facts a reader or an AI assistant asks about a pre-owned bag, as named properties. {%- endcomment -%}
    {%- capture properties -%}
      {%- if condition_grade != blank %}{ "@type": "PropertyValue", "name": "Condition grade", "value": {{ condition_grade | json }} },{% endif -%}
      {%- if condition_summary != blank %}{ "@type": "PropertyValue", "name": "Condition notes", "value": {{ condition_summary | json }} },{% endif -%}
      {%- if year_or_era != blank %}{ "@type": "PropertyValue", "name": "Year or era", "value": {{ year_or_era | json }} },{% endif -%}
      {%- if dimensions != blank %}{ "@type": "PropertyValue", "name": "Dimensions", "value": {{ dimensions | json }} },{% endif -%}
      {%- if size_category != blank %}{ "@type": "PropertyValue", "name": "Size", "value": {{ size_category | json }} },{% endif -%}
      {%- if inclusions != blank %}{ "@type": "PropertyValue", "name": "Included", "value": {{ inclusions | json }} },{% endif -%}
    {%- endcapture -%}
    {%- assign properties = properties | strip -%}
    {%- if properties != blank %}
    "additionalProperty": [ {{ properties | remove_last: ',' }} ],
    {%- endif %}
    {%- if is_used %}
    "itemCondition": "https://schema.org/UsedCondition",
    {%- endif %}
    "offers": [
      {%- for variant in product.variants -%}
        {%- liquid
          assign variant_url = product_url | append: '?variant=' | append: variant.id
          if variant.available
            assign availability = 'https://schema.org/InStock'
          else
            assign availability = 'https://schema.org/SoldOut'
          endif
        -%}
        {
          "@type": "Offer",
          "url": {{ variant_url | json }},
          {%- if variant.sku != blank %}
          "sku": {{ variant.sku | json }},
          {%- endif %}
          "price": {{ variant.price | divided_by: 100.0 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          {%- if is_used %}
          "itemCondition": "https://schema.org/UsedCondition",
          {%- endif %}
          {%- if settings.seo_free_shipping and country_codes.size > 0 %}
          "shippingDetails": {
            "@type": "OfferShippingDetails",
            "shippingRate": { "@type": "MonetaryAmount", "value": 0, "currency": {{ cart.currency.iso_code | json }} },
            "shippingDestination": [
              {%- for code in country_codes -%}
                { "@type": "DefinedRegion", "addressCountry": {{ code | json }} }{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            ]
          },
          {%- endif %}
          {%- if settings.seo_return_days > 0 and country_codes.size > 0 %}
          "hasMerchantReturnPolicy": {
            "@type": "MerchantReturnPolicy",
            "applicableCountry": {{ country_codes | json }},
            "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
            "merchantReturnDays": {{ settings.seo_return_days }},
            "returnMethod": "https://schema.org/ReturnByMail",
            "returnFees": "https://schema.org/ReturnFeesCustomerResponsibility"
          },
          {%- endif %}
          "availability": {{ availability | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>
