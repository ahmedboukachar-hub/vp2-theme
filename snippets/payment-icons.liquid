{% doc %}
  Payment method icons for the visitor's country: the methods people there
  use most, limited to what the store has switched on. iDEAL is always shown
  for the Netherlands (owner decision 2026-10-25, while Shopify reviews it).

  @param {string} [class] - Extra class on the list.
{% enddoc %}
{%- liquid
  case localization.country.iso_code
    when 'NL'
      assign preferred = 'ideal,visa,master,apple_pay,google_pay,klarna,paypal'
    when 'BE'
      assign preferred = 'bancontact,visa,master,apple_pay,google_pay,klarna,paypal'
    when 'DE', 'AT'
      assign preferred = 'paypal,klarna,visa,master,apple_pay,google_pay'
    when 'FR'
      assign preferred = 'visa,master,apple_pay,google_pay,paypal,klarna'
    when 'IT', 'ES', 'PT'
      assign preferred = 'visa,master,paypal,apple_pay,google_pay,klarna'
    else
      assign preferred = 'visa,master,american_express,apple_pay,google_pay,paypal,klarna'
  endcase
  assign preferred = preferred | split: ','
  assign enabled = shop.enabled_payment_types | join: ','
  assign enabled = ',' | append: enabled | append: ','
-%}
<ul class="payment-icons list-unstyled {{ class }}" role="list" aria-label="{{ 'sections.footer.payment' | t | escape }}">
  {%- for type in preferred -%}
    {%- assign needle = ',' | append: type | append: ',' -%}
    {%- if enabled contains needle or type == 'ideal' and localization.country.iso_code == 'NL' -%}
      <li>{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
    {%- endif -%}
  {%- endfor -%}
</ul>
