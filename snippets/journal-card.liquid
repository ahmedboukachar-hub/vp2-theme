{% doc %}
  Renders one Journal card in the editorial system.

  @param {object} article - The article to render.
  @param {string} [variant] - Lead, secondary or grid.
  @param {boolean} [show_excerpt] - Whether to show the standfirst.
  @param {string} [heading_class] - Optional headline class override.
  @param {string} [sizes] - Responsive image sizes value.
  @param {string} [loading] - Image loading mode, 'lazy' (default) or 'eager'.
  @param {string} [fetchpriority] - Image fetch priority, 'auto' (default) or 'high'.

  @example
  {% render 'journal-card', article: article, variant: 'lead' %}
{% enddoc %}

{%- liquid
  assign variant = variant | default: 'secondary'
  assign topic = article.tags | first
  if heading_class == blank
    if variant == 'lead'
      assign heading_class = 'journal-card__title journal-card__title--lead'
    else
      assign heading_class = 'journal-card__title'
    endif
  endif
-%}

{%- liquid
  assign img_loading = loading | default: 'lazy'
  assign img_priority = fetchpriority | default: 'auto'
  assign card_title_id = 'JournalCard-' | append: article.id | append: '-' | append: variant
-%}

<article class="journal-card journal-card--{{ variant }}">
  <a class="journal-card__link" href="{{ article.url }}" aria-labelledby="{{ card_title_id }}">
    {%- if article.image -%}
      <div class="journal-card__media vp-media vp-media--zoom{% if variant == 'lead' %} vp-media--1x1{% elsif variant == 'grid' %} vp-media--4x5{% else %} vp-media--1x1{% endif %}">
        {{
          article.image
          | image_url: width: 1600
          | image_tag:
            loading: img_loading,
            fetchpriority: img_priority,
            widths: '300, 450, 600, 900, 1200, 1600',
            sizes: sizes | default: '(min-width: 990px) 45vw, 100vw',
            alt: ''
        }}
      </div>
    {%- endif -%}

    <div class="journal-card__info">
      {%- if topic != blank -%}
        <span class="vp-eyebrow journal-card__topic">{% render 'journal-topic', topic: topic %}</span>
      {%- endif -%}

      <h3 class="{{ heading_class }}" id="{{ card_title_id }}">{{ article.title | escape }}</h3>

      {%- if show_excerpt != false and article.excerpt_or_content != blank -%}
        <p class="journal-card__excerpt">
          {%- comment -%} A written summary is shown whole; only the article-body fallback is cut short. {%- endcomment -%}
          {%- if article.excerpt != blank -%}
            {{- article.excerpt | strip_html -}}
          {%- else -%}
            {{- article.content | strip_html | truncatewords: 26 -}}
          {%- endif -%}
        </p>
      {%- endif -%}

      <span class="vp-link vp-link--arrow journal-card__read" aria-hidden="true">{{ 'blogs.article.read_article' | t }}</span>
    </div>
  </a>
</article>
