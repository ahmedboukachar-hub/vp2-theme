{% comment %}
  Renders breadcrumb navigation with BreadcrumbList structured data on
  collection, product, blog, article and page templates. Renders nothing
  on any other template. Only real Shopify routes are used — no invented
  parent pages.

  Usage:
  {% render 'breadcrumbs' %}
{% endcomment %}

{%- liquid
  assign current_title = ''
  assign parent_title = ''
  assign parent_url = ''

  case template.name
    when 'collection'
      assign current_title = collection.title
    when 'product'
      assign current_title = product.title
      if collection
        assign parent_title = collection.title
        assign parent_url = collection.url
      endif
    when 'blog'
      assign current_title = blog.title
    when 'article'
      assign current_title = article.title
      assign parent_title = blog.title
      assign parent_url = blog.url
    when 'page'
      assign current_title = page.title
  endcase
-%}

{%- if current_title != blank -%}
  {{ 'component-breadcrumbs.css' | asset_url | stylesheet_tag }}

  {%- liquid
    assign home_label = 'general.breadcrumbs.home' | t
    assign home_item = shop.url | append: routes.root_url
    assign parent_item = shop.url | append: parent_url
    if parent_title != blank
      assign current_position = 3
    else
      assign current_position = 2
    endif
  -%}

  <nav class="breadcrumbs page-width" aria-label="{{ 'general.breadcrumbs.label' | t }}">
    <ol class="breadcrumbs__list">
      <li class="breadcrumbs__item">
        <a class="breadcrumbs__link" href="{{ routes.root_url }}">{{ home_label }}</a>
      </li>
      {%- if parent_title != blank -%}
        <li class="breadcrumbs__item breadcrumbs__item--collapsible">
          <a class="breadcrumbs__link" href="{{ parent_url }}">{{ parent_title | escape }}</a>
        </li>
      {%- endif -%}
      <li class="breadcrumbs__item">
        <span class="breadcrumbs__current" aria-current="page">{{ current_title | escape }}</span>
      </li>
    </ol>
  </nav>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ home_label | json }},
          "item": {{ home_item | json }}
        }{%- if parent_title != blank -%},
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ parent_title | json }},
          "item": {{ parent_item | json }}
        }{%- endif -%},
        {
          "@type": "ListItem",
          "position": {{ current_position }},
          "name": {{ current_title | json }}
        }
      ]
    }
  </script>
{%- endif -%}
