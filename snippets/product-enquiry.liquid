{% comment %}
  "Ask about this piece" — an accessible disclosure with a native Shopify
  contact form. Works without JavaScript (details/summary), needs no app,
  and automatically includes the product title and URL.

  Accepts:
  - product: {Object} Product Liquid object
  - block: {Object} The "enquiry" block
{% endcomment %}

{{ 'component-inspection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign enquiry_id = 'ProductEnquiry-' | append: product.id
  assign form_state = false
-%}

<div class="product-enquiry quick-add-hidden" {{ block.shopify_attributes }}>
  {%- form 'contact', id: enquiry_id, class: 'product-enquiry__form' -%}
    {%- if form.posted_successfully? or form.errors -%}
      {%- assign form_state = true -%}
    {%- endif -%}
    <details class="product-enquiry__disclosure" {% if form_state %}open{% endif %}>
      <summary class="product-enquiry__summary button button--secondary">
        <span>{{ 'products.product.enquiry.button' | t }}</span>
      </summary>
      <div class="product-enquiry__content">
        <h2 class="product-enquiry__heading h4">{{ 'products.product.enquiry.heading' | t }}</h2>
        <p class="product-enquiry__intro">{{ 'products.product.enquiry.intro' | t }}</p>

        {%- if form.posted_successfully? -%}
          <p class="product-enquiry__success form__message" tabindex="-1" autofocus role="status">
            {{ 'icon-success.svg' | inline_asset_content }}
            {{ 'products.product.enquiry.success' | t }}
          </p>
        {%- elsif form.errors -%}
          <p class="product-enquiry__error form__message" tabindex="-1" autofocus role="alert">
            {{ 'icon-error.svg' | inline_asset_content }}
            {{ 'products.product.enquiry.error' | t }}
          </p>
        {%- endif -%}

        <input type="hidden" name="contact[{{ 'products.product.enquiry.hidden_product' | t }}]" value="{{ product.title | escape }}">
        <input type="hidden" name="contact[{{ 'products.product.enquiry.hidden_url' | t }}]" value="{{ request.origin }}{{ product.url }}">

        <div class="field">
          <input
            type="text"
            id="{{ enquiry_id }}-name"
            name="contact[{{ 'products.product.enquiry.name' | t }}]"
            class="field__input"
            value="{% if form.name %}{{ form.name }}{% endif %}"
            placeholder="{{ 'products.product.enquiry.name' | t }}"
            autocomplete="name"
          >
          <label for="{{ enquiry_id }}-name" class="field__label">{{ 'products.product.enquiry.name' | t }}</label>
        </div>
        <div class="field">
          <input
            type="email"
            id="{{ enquiry_id }}-email"
            name="contact[email]"
            class="field__input"
            value="{{ form.email }}"
            placeholder="{{ 'products.product.enquiry.email' | t }}"
            autocomplete="email"
            required
            aria-required="true"
            {% if form.errors contains 'email' %}
              aria-invalid="true"
              aria-describedby="{{ enquiry_id }}-email-error"
            {% endif %}
          >
          <label for="{{ enquiry_id }}-email" class="field__label">{{ 'products.product.enquiry.email' | t }}</label>
          {%- if form.errors contains 'email' -%}
            <small id="{{ enquiry_id }}-email-error" class="contact__field-error">
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </small>
          {%- endif -%}
        </div>
        <div class="field">
          <input
            type="text"
            id="{{ enquiry_id }}-country"
            name="contact[{{ 'products.product.enquiry.country' | t }}]"
            class="field__input"
            placeholder="{{ 'products.product.enquiry.country' | t }}"
            autocomplete="country-name"
          >
          <label for="{{ enquiry_id }}-country" class="field__label">{{ 'products.product.enquiry.country' | t }}</label>
        </div>
        <div class="product-enquiry__topic">
          <label for="{{ enquiry_id }}-topic" class="form__label">{{ 'products.product.enquiry.topic_label' | t }}</label>
          <div class="select">
            <select id="{{ enquiry_id }}-topic" name="contact[{{ 'products.product.enquiry.topic_label' | t }}]" class="select__select">
              <option value="{{ 'products.product.enquiry.topic_condition' | t }}">{{ 'products.product.enquiry.topic_condition' | t }}</option>
              <option value="{{ 'products.product.enquiry.topic_dimensions' | t }}">{{ 'products.product.enquiry.topic_dimensions' | t }}</option>
              <option value="{{ 'products.product.enquiry.topic_authentication' | t }}">{{ 'products.product.enquiry.topic_authentication' | t }}</option>
              <option value="{{ 'products.product.enquiry.topic_shipping' | t }}">{{ 'products.product.enquiry.topic_shipping' | t }}</option>
              <option value="{{ 'products.product.enquiry.topic_other' | t }}">{{ 'products.product.enquiry.topic_other' | t }}</option>
            </select>
            {{ 'icon-caret.svg' | inline_asset_content }}
          </div>
        </div>
        <div class="field">
          <textarea
            rows="5"
            id="{{ enquiry_id }}-message"
            name="contact[body]"
            class="text-area field__input"
            placeholder="{{ 'products.product.enquiry.message' | t }}"
            required
            aria-required="true"
          >{{ form.body }}</textarea>
          <label for="{{ enquiry_id }}-message" class="form__label field__label">{{ 'products.product.enquiry.message' | t }}</label>
        </div>
        <button type="submit" class="button">{{ 'products.product.enquiry.submit' | t }}</button>
      </div>
    </details>
  {%- endform -%}
</div>
