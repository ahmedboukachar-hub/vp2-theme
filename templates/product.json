{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "bags_collection": "all-bags",
            "accessories_collection": "accessories",
            "text_style": "uppercase",
            "designer_collections": [
              "louis-vuitton",
              "gucci",
              "jacquemus",
              "dior"
            ]
          }
        },
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true,
            "sold_similar_collection": "all-bags",
            "sold_new_arrivals_collection": "new-arrivals",
            "sourcing_page": "find-a-bag"
          }
        },
        "description": {
          "type": "description"
        },
        "condition_report": {
          "type": "condition_report",
          "settings": {
            "guide_page": "condition-guide"
          }
        },
        "specifications": {
          "type": "specifications",
          "settings": {}
        },
        "guide_links": {
          "type": "guide_links",
          "settings": {
            "guides_blog": "journal",
            "condition_page": "condition-guide",
            "authenticity_page": "authenticity"
          }
        },
        "what_fits": {
          "type": "what_fits",
          "settings": {
            "size_guide_page": "bag-size-guide"
          }
        },
        "shipping_card": {
          "type": "shipping_card",
          "settings": {
            "shipping_page": "shipping-returns"
          }
        },
        "enquiry": {
          "type": "enquiry"
        },
        "wishlist_button": {
          "type": "wishlist_button"
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        },
        "curators_note": {
          "type": "curators_note",
          "settings": {}
        }
      },
      "block_order": [
        "vendor",
        "title",
        "price",
        "wishlist_button",
        "variant_picker",
        "buy_buttons",
        "description",
        "curators_note",
        "condition_report",
        "specifications",
        "guide_links",
        "what_fits",
        "shipping_card",
        "enquiry",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "enable_sticky_mobile_buy": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "thumbnail_slider",
        "media_size": "medium",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "show",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "products_to_show": 3,
        "columns_desktop": 3,
        "color_scheme": "scheme-1",
        "image_ratio": "portrait",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "recently-viewed": {
      "type": "recently-viewed",
      "settings": {
        "padding_top": 8,
        "padding_bottom": 52
      }
    }
  },
  "order": [
    "main",
    "disclosures",
    "related-products",
    "recently-viewed"
  ]
}
